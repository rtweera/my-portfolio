---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import HomeSystemsDiagram from "@/components/home/HomeSystemsDiagram.astro";
import ProjectArtwork from "@/components/home/ProjectArtwork.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { HOMEPAGE_EDITORIAL } from "@/data/home";
import "@/styles/home.css";

const collection = await getCollection("blog", ({ data }) => !data.draft);
const projects = new Map(collection.map(entry => [entry.id, entry]));
const selectedProjects = HOMEPAGE_EDITORIAL.projects.map(project => {
  const slug = "slug" in project ? project.slug : undefined;
  return { ...project, slug, entry: slug ? projects.get(slug) : undefined };
});
---

<Layout
  title="Ravindu Weerasinghe — Software & Intelligence"
  description="Ravindu Weerasinghe is an AI and Software Engineer with a BSc (Hons) in Artificial Intelligence, currently working as a Software Engineer at Pagero."
>
  <Header />
  <main id="main-content" class="home-page app-layout" data-pagefind-body>
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero-copy">
        <p class="home-kicker">SOFTWARE ENGINEER <span>/</span> AI BACKGROUND</p>
        <h1 id="home-title">Software<br /><span class="hero-highlight">&amp;</span> intelligence.</h1>
        <p class="home-hero-intro">I build dependable software systems, explore applied AI, and enjoy the places where software meets hardware.</p>
        <p class="home-hero-meta">SOFTWARE ENGINEER AT PAGERO <span>/</span> BSc (Hons) IN AI</p>
        <div class="home-hero-actions">
          <a class="home-primary-link" href="#selected-work">View my work <span aria-hidden="true">↗</span></a>
          <a class="home-secondary-link" href="/about/">About me <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="home-hero-art" aria-label="Illustration of AI, software and robotics as connected layers of engineering">
        <HomeSystemsDiagram />
      </div>
    </section>

    <section class="home-work" id="selected-work" aria-labelledby="selected-work-title">
      <div class="home-work-heading">
        <SectionHeading title="Selected work" id="selected-work-title" level={2} />
        <p class="home-work-intro">Projects that bring software, AI and physical systems together.</p>
      </div>

      <div class="home-project-list">
        {selectedProjects.map((project, index) => (
          <article class:list={["home-project", `home-project-${index + 1}`, index % 2 === 1 && "home-project-image-right"]}>
            <div class="home-project-visual">
              {project.entry ? (
                <a href={`/projects/${project.slug}/`} class="home-art-link" aria-label={`Read about ${project.title}`}>
                  <ProjectArtwork kind={project.art} title={`${project.title} technical illustration`} />
                </a>
              ) : (
                <ProjectArtwork kind={project.art} title={`${project.title} illustrative map`} />
              )}
            </div>
            <div class="home-project-copy">
              <p class="home-project-category"><span>{project.number}</span><i aria-hidden="true"></i>{project.category}</p>
              <h3>
                {project.entry ? <a href={`/projects/${project.slug}/`}>{project.title}</a> : project.title}
              </h3>
              <p class="home-project-description">{project.description}</p>
              {project.entry && <a class="home-project-link" href={`/projects/${project.slug}/`}>Explore project <span aria-hidden="true">↗</span></a>}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="home-closing" aria-labelledby="home-closing-title">
      <div class="home-closing-title">
        <span class="home-slash" aria-hidden="true"></span>
        <h2 id="home-closing-title">Software engineering,<br />with an AI perspective.</h2>
      </div>
      <div class="home-closing-copy">
        <p>{HOMEPAGE_EDITORIAL.closing}</p>
        <a class="home-about-link" href="/about/">More about my background <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    if (document.querySelector("#main-content[data-layout='index']")) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
