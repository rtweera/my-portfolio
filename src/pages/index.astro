---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SOCIALS } from "@/constants";
import { HOME_PAGE_CONTENT } from "@/data/home";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const { hero, about, currently, focusAreas, highlights, techStack } = HOME_PAGE_CONTENT;
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">

    <!-- ─── Hero ─────────────────────────────────────────────── -->
    <section id="hero" class:list={["pt-8 pb-6", "border-b border-border"]}>
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        {hero.title}
      </h1>
      <p class="mb-2">
        <strong>{hero.subtitle}</strong>
      </p>
      <p class="mt-6">{hero.paragraphs[0]}</p>
      <p class="mt-6">{hero.paragraphs[1]}</p>
      {
        SOCIALS.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">{hero.socialLabel}</div>
            <Socials />
          </div>
        )
      }
    </section>

    <!-- ─── Featured Projects ─────────────────────────────────── -->
    {
      featuredPosts.length > 0 && (
        <section id="featured" class="pt-12 pb-6 border-b border-border">
          <h2 class="text-2xl font-semibold tracking-wide">Featured Projects</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
          <div class="text-center">
            <LinkButton href="/projects/">
              All Projects
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
        </section>
      )
    }

    <!-- ─── About ─────────────────────────────────────────────── -->
    <section id="about-home" class="border-b border-border pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">{about.title}</h2>
      <p class="my-6">{about.paragraphs[0]}</p>
      <p class="my-6">{about.paragraphs[1]}</p>
      <div class="text-center">
        <LinkButton href={about.cta.href}>
          {about.cta.text}
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
      </div>
    </section>

    <!-- ─── Highlights ────────────────────────────────────────── -->
    <section id="highlights-home" class="border-b border-border pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">{highlights.title}</h2>
      <ul class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
        {
          highlights.items.map(({ label, description, href }) => (
            <li class="rounded border border-border p-4">
              {href ? (
                <a
                  href={href}
                  target={href.startsWith("http") ? "_blank" : "_self"}
                  rel={href.startsWith("http") ? "noopener noreferrer" : undefined}
                  class="group block"
                >
                  <p class="font-semibold text-accent group-hover:underline decoration-dashed underline-offset-4">
                    {label}
                  </p>
                  <p class="mt-1 text-sm opacity-75">{description}</p>
                </a>
              ) : (
                <>
                  <p class="font-semibold text-accent">{label}</p>
                  <p class="mt-1 text-sm opacity-75">{description}</p>
                </>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ─── Currently ─────────────────────────────────────────── -->
    <section id="currently-home" class="border-b border-border pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">{currently.title}</h2>
      <ul class="mt-5 list-disc space-y-3 ps-6">
        {currently.items.map(item => <li>{item}</li>)}
      </ul>
      <div class="mt-6 text-center">
        <LinkButton href={currently.cta.href}>
          {currently.cta.text}
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
      </div>
    </section>

    <!-- ─── Focus Areas ───────────────────────────────────────── -->
    <section id="focus-areas-home" class="border-b border-border pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">{focusAreas.title}</h2>
      <p class="mt-4">{focusAreas.text}</p>
    </section>

    <!-- ─── Tech Stack ────────────────────────────────────────── -->
    <section id="tech-home" class="pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">{techStack.title}</h2>
      <div class="mt-6 space-y-4">
        {
          techStack.groups.map(({ label, items }) => (
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
              <span class="w-28 shrink-0 text-sm font-semibold text-accent opacity-80">
                {label}
              </span>
              <div class="flex flex-wrap gap-2">
                {items.map(item => (
                  <span class="rounded border border-border px-2 py-0.5 text-sm opacity-75">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>