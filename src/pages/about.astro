---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ProfileIllustration from "@/components/pages/ProfileIllustration.astro";
import InterestIcon from "@/components/pages/InterestIcon.astro";
import Socials from "@/components/Socials.astro";
import { SITE } from "@/config";
import "@/styles/about-now.css";

const interests = [
  { kind: "ai", label: "AI & machine learning" },
  { kind: "vision", label: "Computer vision" },
  { kind: "nlp", label: "Natural language processing" },
  { kind: "distributed", label: "Distributed systems" },
  { kind: "agents", label: "Multi-agent systems" },
  { kind: "robotics", label: "Robotics" },
  { kind: "electronics", label: "Electronics" },
  { kind: "security", label: "Cybersecurity" },
] as const;

const layoutProps = {
  title: `About | ${SITE.title}`,
  description:
    "I am an AI and Software Engineer interested in dependable software, intelligent systems and physical computing.",
};
---

<Layout {...layoutProps}>
  <Header />
  <main
    id="main-content"
    class="about-now-page about-page app-layout"
    data-pagefind-body
  >
    <section class="profile-hero" aria-labelledby="about-title">
      <div class="profile-hero-copy">
        <p class="profile-kicker">About me</p>
        <h1 id="about-title">
          An engineer across <span class="profile-highlight">software, AI</span>
          and physical systems.
        </h1>
        <p class="profile-hero-intro">
          I have a degree in Artificial Intelligence and work as a Software
          Engineer at Pagero, a Thomson Reuters company. I enjoy building
          useful, dependable systems and exploring how software, intelligence
          and the physical world can work together.
        </p>
      </div>
      <figure class="profile-hero-visual">
        <ProfileIllustration mode="about" />
        <figcaption class="profile-visual-caption">
          Software · intelligence · physical systems
        </figcaption>
      </figure>
    </section>

    <section class="profile-role" aria-labelledby="role-title">
      <div>
        <p class="profile-eyebrow">Currently</p>
        <h2 id="role-title">Software Engineer</h2>
        <p class="profile-role-company">
          Pagero <span>— a Thomson Reuters company</span>
        </p>
      </div>
      <p class="profile-role-note">
        My work is building my practical software engineering experience, with
        an ongoing interest in backend systems, distributed technologies and
        reliable services.
      </p>
    </section>

    <section
      class="profile-background profile-section"
      aria-labelledby="background-title"
    >
      <div class="profile-background-copy">
        <SectionHeading
          title="A connected background"
          label="Background"
          id="background-title"
        />
        <p>
          I’m an AI and Software Engineer. My Artificial Intelligence degree
          gave me a foundation in machine learning, computer vision and language
          technologies; my professional experience is growing through the
          practice of designing and building software.
        </p>
        <p>
          I’m drawn to the space where those areas meet: intelligent
          capabilities built into useful software, supported by sound backend
          engineering, and sometimes connected to physical devices.
        </p>
      </div>
      <aside class="profile-education" aria-labelledby="education-title">
        <p class="profile-eyebrow">Education</p>
        <h2 id="education-title">University of Moratuwa</h2>
        <p class="profile-education-degree">
          Bachelor of Science (Hons) in Artificial Intelligence
        </p>
        <p class="profile-education-result">
          <span>Final CGPA</span><strong>3.81 <small>/ 4.00</small></strong>
        </p>
      </aside>
    </section>

    <section
      class="profile-interests profile-section"
      aria-labelledby="interests-title"
    >
      <SectionHeading
        title="Questions I keep returning to"
        label="Areas of interest"
        id="interests-title"
        aside="These are areas I enjoy learning about and exploring, rather than claims of specialisation."
      />
      <ul class="interest-list">
        {
          interests.map(interest => (
            <li>
              <>
                <InterestIcon kind={interest.kind} />
                <span>{interest.label}</span>
              </>
            </li>
          ))
        }
      </ul>
    </section>

    <section
      class="profile-beyond profile-section"
      aria-labelledby="beyond-title"
    >
      <div class="profile-beyond-label">
        <p class="profile-eyebrow">Outside the work</p>
        <h2 id="beyond-title">Beyond work</h2>
      </div>
      <div class="profile-beyond-copy">
        <p>
          Outside engineering, I play badminton and guitar, and enjoy mystery
          novels. They give me a welcome change of pace from work and study.
        </p>
        <p>
          I also value hands-on projects that bring software and hardware
          together; building AutoChess remains one of the experiences that
          shaped that interest.
        </p>
      </div>
      <div
        class="profile-beyond-art"
        role="img"
        aria-label="Badminton, guitar and mystery novels"
      >
        <span>PLAY</span><span>MUSIC</span><span>READ</span><i
          aria-hidden="true"></i>
      </div>
    </section>

    <section class="profile-closing" aria-labelledby="closing-title">
      <div>
        <p class="profile-eyebrow">Explore</p>
        <h2 id="closing-title">A little more of what I build.</h2>
      </div>
      <div class="profile-closing-actions">
        <a class="profile-text-link" href="/projects/"
          >Browse selected projects <span aria-hidden="true">↗</span></a
        >
        <a class="profile-text-link" href="/"
          >Back to the homepage <span aria-hidden="true">↗</span></a
        >
        <Socials />
      </div>
    </section>
  </main>
  <Footer />
</Layout>
