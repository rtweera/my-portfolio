---
import Layout from "@/layouts/Layout.astro";
import SystemsDiagram from "@/components/preview/SystemsDiagram.astro";
import ProjectIllustration from "@/components/preview/ProjectIllustration.astro";
import { SOCIALS } from "@/constants";
import "@/styles/design-preview.css";

const projects = [
  {
    number: "01",
    name: "SentiView",
    kind: "sentiview" as const,
    category: "APPLIED AI / COMMUNICATIONS",
    description: "An email analytics system combining ingestion, AI-powered classification and summaries, and an analytics interface.",
    href: "/projects/sentiview-icms/",
    linkLabel: "Read project notes",
  },
  {
    number: "02",
    name: "AutoChess",
    kind: "autochess" as const,
    category: "ROBOTICS / EMBEDDED SYSTEMS",
    description: "A physical chessboard that senses moves, computes a response, and moves pieces with an XY gantry.",
    href: "/projects/autochess/",
    linkLabel: "Read project notes",
  },
  {
    number: "03",
    name: "AI Blog Microservice",
    kind: "microservice" as const,
    category: "BACKEND / DISTRIBUTED SYSTEMS",
    description: "A FastAPI and MongoDB service for blog content, comments, reactions, and dashboard analytics.",
    href: "/projects/chapters-blog-backend/",
    linkLabel: "Read project notes",
  },
  {
    number: "04",
    name: "StumblePanni",
    kind: "stumblepanni" as const,
    category: "MOBILE / PLACE-BASED ASSISTANCE",
    description: "A tourist assistance application for exploring Sri Lanka.",
  },
];

const pageTitle = "Systems Atlas — Ravindu Weerasinghe";
---

<Layout title={pageTitle} description="A visual portfolio prototype exploring the intersection of software engineering, applied AI, and physical systems.">
  <div class="atlas-page" id="top">
    <a class="atlas-skip" href="#main-content">Skip to content</a>
    <header class="atlas-header">
      <a class="atlas-wordmark" href="/design-preview/" aria-label="Ravindu Weerasinghe, design preview home">
        <span class="wordmark-symbol" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>RAVINDU<br /><b>WEERASINGHE</b></span>
      </a>
      <button class="atlas-menu-toggle" type="button" aria-expanded="false" aria-controls="atlas-nav" aria-label="Open navigation">
        <span></span><span></span>
      </button>
      <nav class="atlas-nav" id="atlas-nav" aria-label="Main navigation">
        <a href="#work">Work</a>
        <a href="#about">About</a>
        <a href="#now">Now</a>
        <button id="theme-btn" class="atlas-theme-toggle" type="button" title="Toggle light and dark theme" aria-label="Toggle theme">
          <svg class="theme-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
          <span class="sr-only">Toggle light and dark theme</span>
        </button>
      </nav>
    </header>

    <main id="main-content">
      <section class="atlas-hero" aria-labelledby="hero-title">
        <div class="hero-copy reveal">
          <p class="eyebrow"><span class="status-mark"></span> SOFTWARE ENGINEERING <span class="eyebrow-separator">×</span> APPLIED AI</p>
          <h1 id="hero-title">Building software systems.<br /><em>Exploring intelligent machines.</em></h1>
          <p class="hero-intro">I’m Ravindu, an AI and software engineer with a BSc (Hons) in Artificial Intelligence, currently working at Pagero, a Thomson Reuters company. I’m interested in the places where dependable software, intelligent systems and the physical world meet.</p>
          <div class="hero-meta">
            <span><b>BASED IN</b> Sri Lanka</span>
            <span><b>WORKING ACROSS</b> Software · AI · Devices</span>
          </div>
          <a class="text-link hero-link" href="#work">Explore selected work <span aria-hidden="true">↘</span></a>
        </div>
        <div class="hero-visual reveal" style="--reveal-delay: 120ms">
          <div class="visual-topline"><span>FIELD NOTE 001</span><span>CONNECTIONS / 01—04</span></div>
          <SystemsDiagram />
          <div class="visual-caption"><span>Components become systems</span><span>FIG. 01</span></div>
        </div>
        <div class="hero-index" aria-hidden="true"><span>01</span><i></i><span>07</span></div>
      </section>

      <section class="work-section" id="work" aria-labelledby="work-title">
        <div class="section-heading reveal">
          <div><p class="eyebrow">SELECTED WORK <span class="heading-rule"></span> 2023—NOW</p><h2 id="work-title">Built across<br /><em>different scales.</em></h2></div>
          <p class="section-intro">From a model analysing language to a machine moving pieces on a board, the common thread is making connected parts work together.</p>
        </div>
        <div class="project-list">
          {projects.map((project, index) => (
            <article class:list={["project-row", `project-row-${index + 1}`, "reveal"]} style={{ "--reveal-delay": `${index * 70}ms` }}>
              <div class="project-visual-wrap">
                <span class="project-coordinate">PLATE {project.number} <i>·</i> {project.category.split(" /")[0]}</span>
                <ProjectIllustration kind={project.kind} label={`${project.name} illustration`} />
                <span class="project-visual-index">{project.number}<span>/ 04</span></span>
              </div>
              <div class="project-copy">
                <p class="eyebrow project-category"><span>{project.number}</span> {project.category}</p>
                <h3>{project.name}</h3>
                <p>{project.description}</p>
                {project.href && <a class="text-link" href={project.href}>{project.linkLabel} <span aria-hidden="true">↗</span></a>}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="experience-section" aria-labelledby="experience-title">
        <div class="experience-label reveal"><p class="eyebrow">IN PRACTICE</p><span class="section-index">02 / EXPERIENCE</span></div>
        <div class="experience-body reveal">
          <div class="experience-heading"><span class="timeline-marker" aria-hidden="true"></span><p class="eyebrow">CURRENT ROLE</p></div>
          <h2 id="experience-title">Software Engineer<br /><em>at Pagero</em></h2>
          <p class="company-line">A Thomson Reuters company</p>
          <p class="experience-copy">Working in software engineering, with a focus on production software, backend systems and distributed technologies.</p>
        </div>
        <div class="experience-side reveal"><span class="side-note">ENGINEERING<br />IN CONTEXT</span><div class="side-diagram" aria-hidden="true"><span>services</span><i></i><span>systems</span><i></i><span>people</span></div></div>
      </section>

      <section class="about-section" id="about" aria-labelledby="about-title">
        <div class="about-marker reveal"><span>03</span><i></i><span>ABOUT</span></div>
        <div class="about-copy reveal"><p class="eyebrow">A LITTLE CONTEXT</p><h2 id="about-title">One foot in software.<br /><em>One in intelligent systems.</em></h2></div>
        <div class="about-detail reveal"><p>My background spans artificial intelligence, software engineering, computer vision, NLP, backend systems, cloud technologies, robotics and electronics. I enjoy understanding how the pieces fit together—and what it takes to make them useful beyond a demo.</p><a class="text-link" href="/about/">More about my background <span aria-hidden="true">↗</span></a></div>
      </section>

      <section class="now-section" id="now" aria-labelledby="now-title">
        <div class="now-index reveal"><p class="eyebrow">FIELD NOTES</p><span>04 / IN PROGRESS</span></div>
        <div class="now-content reveal"><div class="now-title-row"><h2 id="now-title">Now<span class="period">.</span></h2><a class="text-link" href="/now/">Open current notes <span aria-hidden="true">↗</span></a></div><p>A short view of what I’m focused on at the moment—kept on a separate page so it can evolve as the work does.</p></div>
        <div class="now-mark" aria-hidden="true"><span>R</span><i></i><span>W</span></div>
      </section>
    </main>

    <footer class="atlas-footer">
      <a class="footer-name" href="#top">Ravindu Weerasinghe <span>© {new Date().getFullYear()}</span></a>
      <p>Engineering the connections.</p>
      <div class="footer-links">
        {SOCIALS.map(social => <a href={social.href} aria-label={social.linkTitle} title={social.linkTitle} target={social.href.startsWith("http") ? "_blank" : undefined} rel={social.href.startsWith("http") ? "noopener noreferrer" : undefined}><social.icon aria-hidden="true" /></a>)}
      </div>
      <a class="back-top" href="#top" aria-label="Back to top">↑</a>
    </footer>
  </div>
</Layout>

<script>
  const navToggle = document.querySelector<HTMLButtonElement>(".atlas-menu-toggle");
  const nav = document.querySelector<HTMLElement>("#atlas-nav");

  navToggle?.addEventListener("click", () => {
    const isOpen = navToggle.getAttribute("aria-expanded") === "true";
    navToggle.setAttribute("aria-expanded", String(!isOpen));
    navToggle.setAttribute("aria-label", isOpen ? "Open navigation" : "Close navigation");
    nav?.classList.toggle("is-open", !isOpen);
  });

  nav?.querySelectorAll("a").forEach(link => link.addEventListener("click", () => {
    nav?.classList.remove("is-open");
    navToggle?.setAttribute("aria-expanded", "false");
    navToggle?.setAttribute("aria-label", "Open navigation");
  }));

  const revealObserver = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add("is-visible");
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12 });

  document.querySelectorAll(".reveal").forEach(element => revealObserver.observe(element));
</script>
