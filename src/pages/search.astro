---
import "@pagefind/default-ui/css/ui.css";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
import "@/styles/work-search.css";

const searchUrl = (term: string) => `/search/?q=${encodeURIComponent(term)}`;
const examples = [
  "AutoChess",
  "Computer Vision",
  "Distributed Systems",
  "Pagero",
  "RAG",
];
---

<Layout
  title={`Search | ${SITE.title}`}
  description="Search projects, technologies and ideas across Ravindu Weerasinghe’s portfolio."
>
  <Header />
  <main id="main-content" class="search-page app-layout">
    <section class="search-intro" aria-labelledby="search-title">
      <p class="archive-kicker">Explore the portfolio</p>
      <h1 id="search-title">Search.</h1>
      <p class="search-lead">
        Find projects, technologies and topics across my work and profile.
      </p>
    </section>

    <section class="search-interface" aria-label="Portfolio search">
      <div
        id="pagefind-search"
        data-backurl={SITE.showBackButton ? Astro.url.pathname : "/"}
        data-search-root
      >
      </div>
      <div class="search-initial-state">
        <p class="search-hint">Try a topic</p>
        <ul aria-label="Example searches">
          {
            examples.map(term => (
              <li>
                <a href={searchUrl(term)}>{term}</a>
              </li>
            ))
          }
        </ul>
        <p class="search-index-note">
          Search spans project details, the homepage and public profile pages.
          The index is refreshed during the site build.
        </p>
      </div>
      <p class="search-load-error" role="status" hidden>
        Search could not load just now. Please try again after the site finishes
        loading.
      </p>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  let searchInitInProgress = false;

  async function initPortfolioSearch() {
    const root = document.querySelector<HTMLElement>("[data-search-root]");
    if (!root || root.dataset.initialized === "true" || searchInitInProgress)
      return;

    searchInitInProgress = true;
    const params = new URLSearchParams(window.location.search);
    const query = params.get("q")?.trim() ?? "";

    try {
      // @ts-expect-error — Pagefind's default UI package does not publish TypeScript declarations.
      const { PagefindUI } = await import("@pagefind/default-ui");
      if (!root.isConnected) return;

      const search = new PagefindUI({
        element: "#pagefind-search",
        showImages: false,
        showSubResults: true,
        processTerm(term: string) {
          const next = new URL(window.location.href);
          if (term.trim()) next.searchParams.set("q", term.trim());
          else next.searchParams.delete("q");
          history.replaceState(
            history.state,
            "",
            next.pathname + next.search + next.hash
          );
          root.classList.toggle("search-page--has-query", Boolean(term.trim()));
          return term;
        },
      });

      root.dataset.initialized = "true";
      root.classList.toggle("search-page--has-query", Boolean(query));
      if (query) search.triggerSearch(query);

      const input = root.querySelector<HTMLInputElement>(
        ".pagefind-ui__search-input"
      );
      const clear = root.querySelector<HTMLButtonElement>(
        ".pagefind-ui__search-clear"
      );
      input?.addEventListener("input", () => {
        const hasQuery = Boolean(input.value.trim());
        root.classList.toggle("search-page--has-query", hasQuery);
        if (!hasQuery)
          history.replaceState(history.state, "", window.location.pathname);
      });
      clear?.addEventListener("click", () => {
        root.classList.remove("search-page--has-query");
        history.replaceState(history.state, "", window.location.pathname);
      });
      root.addEventListener("click", event => {
        const target = (
          event.target as HTMLElement | null
        )?.closest<HTMLAnchorElement>(".pagefind-ui__result-link");
        const activeQuery = new URLSearchParams(window.location.search).get(
          "q"
        );
        if (!target || !activeQuery) return;
        const resultUrl = new URL(target.href);
        resultUrl.searchParams.set("q", activeQuery);
        target.href = resultUrl.toString();
        const backUrl = root.dataset.backurl ?? "/";
        sessionStorage.setItem(
          "backUrl",
          `${backUrl}?q=${encodeURIComponent(activeQuery)}`
        );
      });
    } catch {
      root
        .closest<HTMLElement>(".search-interface")
        ?.querySelector<HTMLElement>(".search-load-error")
        ?.removeAttribute("hidden");
    } finally {
      searchInitInProgress = false;
    }
  }

  document.addEventListener("astro:page-load", initPortfolioSearch);
  initPortfolioSearch();
</script>
