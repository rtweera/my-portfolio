---
interface Props {
  mode: "about" | "now" | "learning";
}

const { mode } = Astro.props;
const copy = {
  about: {
    title: "Software, AI and physical systems illustration",
    description:
      "Three connected engineering layers represent software systems, artificial intelligence, and physical devices.",
  },
  now: {
    title: "Build, observe and improve engineering loop",
    description:
      "A software system connects to observation and reliability signals, forming a practical build and improve cycle.",
  },
  learning: {
    title: "Current learning areas illustration",
    description:
      "A stack of books represents ongoing learning in software systems, cloud technologies, functional programming and AI.",
  },
} as const;

const titleId = `profile-illustration-title-${mode}`;
const descriptionId = `profile-illustration-description-${mode}`;
---

<svg
  class:list={["profile-illustration", `profile-illustration--${mode}`]}
  viewBox="0 0 680 460"
  role="img"
  aria-labelledby={`${titleId} ${descriptionId}`}
>
  <title id={titleId}>{copy[mode].title}</title>
  <desc id={descriptionId}>{copy[mode].description}</desc>
  <defs>
    <pattern
      id={`profile-grid-${mode}`}
      width="22"
      height="22"
      patternUnits="userSpaceOnUse"
    >
      <path d="M22 0H0V22" class="profile-grid-line"></path>
    </pattern>
  </defs>
  <rect width="680" height="460" class="profile-visual-ground"></rect>
  <rect width="680" height="460" fill={`url(#profile-grid-${mode})`}></rect>

  {
    mode === "about" && (
      <g class="profile-stack-art">
        <path d="M78 119 340 43l262 76-262 77z" class="profile-layer-top" />
        <path
          d="M78 119v34l262 78v-35zM602 119v34l-262 78v-35z"
          class="profile-layer-side"
        />
        <path d="M106 119 340 52l234 67-234 68z" class="profile-layer-inset" />
        <path d="m190 117 150-43 150 43-150 43z" class="profile-layer-core" />
        <path
          d="M78 226 340 150l262 76-262 77z"
          class="profile-layer-top profile-layer-ai"
        />
        <path
          d="M78 226v34l262 78v-35zM602 226v34l-262 78v-35z"
          class="profile-layer-side"
        />
        <path d="M111 226 340 160l229 66-229 66z" class="profile-layer-inset" />
        <path d="m238 226 102-29 102 29-102 30z" class="profile-layer-core" />
        <path d="M78 333 340 257l262 76-262 77z" class="profile-layer-top" />
        <path
          d="M78 333v34l262 78v-35zM602 333v34l-262 78v-35z"
          class="profile-layer-side"
        />
        <path d="M106 333 340 266l234 67-234 68z" class="profile-layer-inset" />
        <path d="M287 333h106v-23l-53-16-53 16z" class="profile-layer-core" />
        <path d="M340 188v-11m0 105v-12m0 106v-12" class="profile-layer-link" />
        <circle cx="340" cy="183" r="4" class="profile-layer-joint" />
        <circle cx="340" cy="290" r="4" class="profile-layer-joint" />
        <circle cx="340" cy="397" r="4" class="profile-layer-joint" />
        <text x="88" y="106" class="profile-illustration-label">
          SOFTWARE SYSTEMS
        </text>
        <text x="88" y="213" class="profile-illustration-label">
          ARTIFICIAL INTELLIGENCE
        </text>
        <text x="88" y="320" class="profile-illustration-label">
          PHYSICAL DEVICES
        </text>
        <text x="500" y="191" class="profile-illustration-note">
          DESIGN
        </text>
        <text x="500" y="298" class="profile-illustration-note">
          INFERENCE
        </text>
        <text x="500" y="405" class="profile-illustration-note">
          SENSING
        </text>
      </g>
    )
  }

  {
    mode === "now" && (
      <g class="profile-now-art">
        <text x="46" y="54" class="profile-illustration-label">
          A PRACTICAL ENGINEERING LOOP
        </text>
        <path d="M126 204h428" class="profile-now-track" />
        <path
          d="m269 196 11 8-11 8m161-16 11 8-11 8"
          class="profile-now-arrow"
        />
        <path d="M72 111h150v192H72z" class="profile-now-window" />
        <path
          d="M72 139h150M91 166h96m-96 19h119m-119 19h71m-71 31h113m-113 20h88"
          class="profile-now-rule"
        />
        <circle cx="91" cy="125" r="3" class="profile-now-dot" />
        <circle cx="104" cy="125" r="3" class="profile-now-dot" />
        <circle cx="117" cy="125" r="3" class="profile-now-dot" />
        <path
          d="M280 100h120v212H280zM302 125h76m-76 18h55m-55 51h76m-76 18h61m-61 51h76m-76 18h46"
          class="profile-now-service"
        />
        <path
          d="m302 170 12-11 12 17 12-6 12 15 15-20 13 11"
          class="profile-now-signal"
        />
        <path
          d="M463 111h145v192H463zM484 266v-42h13v42zm27 0v-76h13v76zm27 0v-57h13v57zm27 0v-96h13v96"
          class="profile-now-observe"
        />
        <circle cx="550" cy="152" r="16" class="profile-now-cycle" />
        <path d="m550 141 7 11-7 11-7-11z" class="profile-now-cycle-mark" />
        <text x="72" y="342" class="profile-illustration-label">
          BUILD
        </text>
        <text x="280" y="342" class="profile-illustration-label">
          SYSTEMS
        </text>
        <text x="463" y="342" class="profile-illustration-label">
          OBSERVE
        </text>
        <text x="72" y="365" class="profile-illustration-note">
          Software foundations
        </text>
        <text x="280" y="365" class="profile-illustration-note">
          Services and messaging
        </text>
        <text x="463" y="365" class="profile-illustration-note">
          Reliability and insight
        </text>
        <path d="M136 404h408" class="profile-now-bottom-rule" />
        <circle cx="136" cy="404" r="4" class="profile-layer-joint" />
        <circle cx="544" cy="404" r="4" class="profile-layer-joint" />
        <text
          x="318"
          y="429"
          text-anchor="middle"
          class="profile-illustration-label"
        >
          BUILD · OBSERVE · IMPROVE
        </text>
      </g>
    )
  }

  {
    mode === "learning" && (
      <g class="profile-books-art">
        <text x="50" y="54" class="profile-illustration-label">
          AREAS I’M BUILDING DEPTH IN
        </text>
        <path d="M118 324 510 324l78 30-395 1z" class="profile-book-page" />
        <path d="M193 355v22l395-1v-22" class="profile-book-side" />
        <path d="M150 277 542 277l46 23-395 1z" class="profile-book-cover" />
        <path d="M193 301v24l395-1v-24" class="profile-book-side" />
        <path d="M105 226 497 226l91 27-395 1z" class="profile-book-page" />
        <path d="M193 254v23l395-1v-23" class="profile-book-side" />
        <path
          d="M169 174 561 174l27 26-395 1z"
          class="profile-book-cover profile-book-highlight"
        />
        <path d="M193 201v25l395-1v-25" class="profile-book-side" />
        <path d="m540 174 20 4v55l-20-7z" class="profile-bookmark" />
        <text x="219" y="220" class="profile-book-title">
          Scala + functional programming
        </text>
        <text x="219" y="273" class="profile-book-title">
          Distributed systems
        </text>
        <text x="219" y="321" class="profile-book-title">
          Cloud and AWS
        </text>
        <text x="219" y="371" class="profile-book-title">
          AI · computer vision · NLP
        </text>
        <path d="M125 407h434" class="profile-book-ground" />
      </g>
    )
  }
</svg>
