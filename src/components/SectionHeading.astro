---
interface Props {
  title: string;
  label?: string;
  aside?: string;
  level?: 2 | 3;
  id?: string;
}

const { title, label, aside, level = 2, id } = Astro.props;
const Heading = `h${level}` as const;
---

<div class="editorial-heading">
  <div class="editorial-heading-main">
    {label && <p class="editorial-label">{label}</p>}
    <div class="editorial-heading-row">
      <span class="editorial-slash" aria-hidden="true"></span>
      <Heading id={id}>{title}</Heading>
    </div>
  </div>
  {aside && <p class="editorial-heading-aside">{aside}</p>}
</div>

<style>
  .editorial-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }
  .editorial-heading-main { display: grid; gap: .55rem; }
  .editorial-label { margin: 0; color: var(--foreground-muted); font: 500 .65rem/1.4 var(--type-mono); letter-spacing: .09em; text-transform: uppercase; }
  .editorial-heading-row { display: flex; align-items: center; gap: .8rem; }
  .editorial-slash { display: block; width: 13px; height: 35px; flex: none; transform: skew(-22deg); background: var(--signal); }
  h2, h3 { margin: 0; color: var(--foreground); font: 750 clamp(1.7rem, 4vw, 2.8rem)/1.05 var(--type-display); letter-spacing: -.055em; }
  .editorial-heading-aside { max-width: 34ch; margin: 0 0 .2rem; color: var(--foreground-muted); font: 400 .93rem/1.6 var(--type-body); }
  @media (max-width: 639px) { .editorial-heading { align-items: start; flex-direction: column; gap: .8rem; } .editorial-slash { width: 9px; height: 27px; } }
</style>
