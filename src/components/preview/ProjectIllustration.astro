---
interface Props {
  kind: "sentiview" | "autochess" | "microservice" | "stumblepanni";
  label: string;
}

const { kind, label } = Astro.props;
---

<div class:list={["project-art", `art-${kind}`]} aria-label={label}>
  {kind === "sentiview" && (
    <svg viewBox="0 0 500 250" role="img" aria-label="Email messages moving through analysis and into an insight dashboard">
      <path d="M80 125H174M254 125H340" class="art-route" />
      <rect x="22" y="78" width="96" height="94" rx="4" class="art-panel" />
      <path d="m36 94 34 26 34-26M36 151h68" class="art-stroke" />
      <circle cx="70" cy="72" r="4" class="art-pin" />
      <text x="70" y="195" text-anchor="middle" class="art-label">INBOX</text>
      <rect x="180" y="70" width="78" height="110" rx="4" class="art-panel art-panel-accent" />
      <path d="M196 96h46M196 111h35M196 141h46M196 156h28" class="art-stroke" />
      <circle cx="219" cy="124" r="7" class="art-pin" />
      <text x="219" y="202" text-anchor="middle" class="art-label">ANALYZE</text>
      <rect x="346" y="58" width="130" height="132" rx="4" class="art-panel" />
      <path d="M362 78h97M362 94h53" class="art-stroke faint" />
      <path d="M364 164v-18h18v18M390 164v-42h18v42M416 164v-30h18v30M442 164v-54h17v54" class="art-chart" />
      <text x="411" y="211" text-anchor="middle" class="art-label">INSIGHTS</text>
      <text x="137" y="114" class="art-micro">EMAIL</text><text x="286" y="114" class="art-micro">SIGNALS</text>
    </svg>
  )}
  {kind === "autochess" && (
    <svg viewBox="0 0 500 300" role="img" aria-label="Chessboard with a moving piece and a mechanical gantry path">
      <path d="M98 65H400V254H98Z" class="board-frame" />
      <path d="M136 65v189M174 65v189M212 65v189M250 65v189M288 65v189M326 65v189M364 65v189M98 103h302M98 141h302M98 179h302M98 217h302" class="board-grid" />
      <path d="M98 65h38v38H98m76 0h38v38h-38m76-38h38v38h-38m76-38h38v38h-38m38 38h38v38h-38m-76 0h38v38h-38m-76-38h38v38h-38m-76-38h38v38h-38" class="board-shade" />
      <path d="M155 123H345V199H269" class="gantry-route" />
      <circle cx="155" cy="123" r="5" class="art-pin" /><circle cx="269" cy="199" r="5" class="art-pin" />
      <path d="M345 52v20M332 52h26M338 72h14l-3 18h-8z" class="gantry" />
      <circle cx="345" cy="64" r="3" class="art-pin" />
      <text x="98" y="278" class="art-label">SENSE</text><text x="226" y="278" class="art-label">COMPUTE</text><text x="342" y="278" class="art-label">MOVE</text>
      <text x="401" y="55" class="art-micro">XY GANTRY / 01</text>
    </svg>
  )}
  {kind === "microservice" && (
    <svg viewBox="0 0 500 260" role="img" aria-label="API gateway connecting to a FastAPI service and MongoDB storage">
      <rect x="24" y="84" width="102" height="82" rx="4" class="art-panel" />
      <path d="M45 108h60M45 124h44M45 140h52" class="art-stroke" />
      <text x="75" y="190" text-anchor="middle" class="art-label">CLIENT</text>
      <path d="M126 125h58M286 125h68" class="art-route" />
      <rect x="188" y="67" width="100" height="116" rx="4" class="art-panel art-panel-accent" />
      <path d="M207 97h62M207 113h48M207 145h62M207 161h36" class="art-stroke" />
      <circle cx="238" cy="130" r="7" class="art-pin" />
      <text x="238" y="207" text-anchor="middle" class="art-label">FASTAPI</text>
      <ellipse cx="402" cy="92" rx="46" ry="14" class="db-cap" /><path d="M356 92v75c0 8 21 15 46 15s46-7 46-15V92M356 130c0 8 21 15 46 15s46-7 46-15" class="db-line" />
      <text x="402" y="211" text-anchor="middle" class="art-label">MONGODB</text>
      <text x="145" y="114" class="art-micro">HTTP / JSON</text><text x="305" y="114" class="art-micro">PERSISTENCE</text>
    </svg>
  )}
  {kind === "stumblepanni" && (
    <svg viewBox="0 0 500 260" role="img" aria-label="A map-inspired route connecting a traveler to places and assistance">
      <path d="M32 46 155 31l103 21 104-19 104 20v174l-104-19-104 23-103-21-123 20z" class="map-area" />
      <path d="M57 78c48 17 34 49 84 42s44-35 82-18 35 48 82 37 48-43 91-27 46 42 76 30M76 181c36-29 59-28 91-12s49 8 75-18 52-22 79-8 48 17 91-9" class="map-road" />
      <path d="M118 119c32-53 79-38 119-17s57 48 97 13" class="map-route" />
      <circle cx="118" cy="119" r="8" class="map-pin" /><circle cx="334" cy="115" r="8" class="map-pin map-pin-end" />
      <circle cx="238" cy="102" r="5" class="map-stop" />
      <rect x="177" y="73" width="122" height="38" rx="3" class="map-callout" />
      <text x="238" y="89" text-anchor="middle" class="art-micro">LOCAL CONTEXT</text><text x="238" y="102" text-anchor="middle" class="art-label">A ROUTE, NOT A LIST</text>
      <text x="58" y="232" class="art-label">SRI LANKA / PLACE-BASED ASSISTANCE</text>
    </svg>
  )}
</div>
