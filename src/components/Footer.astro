---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";

const currentYear = new Date().getFullYear();
type Props = { noMarginTop?: boolean } & HTMLAttributes<"footer">;
const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer class:list={["site-footer app-layout", { "mt-auto": !noMarginTop }, className]} {...attrs}>
  <div class="site-footer-rule" aria-hidden="true"></div>
  <div class="site-footer-content">
    <p class="site-footer-credit"><span>© {currentYear} Ravindu Weerasinghe</span><span class="footer-divider" aria-hidden="true">/</span><span>Built with AstroPaper</span></p>
    <Socials />
  </div>
</footer>
