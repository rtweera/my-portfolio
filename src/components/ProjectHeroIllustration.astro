---
interface Props {
  kind:
    | "autochess"
    | "sentiview"
    | "blog-service"
    | "rag-platform"
    | "ballerina-ft"
    | "choreo-pipeline"
    | "clickbait"
    | "compfigurator"
    | "ddos"
    | "diabetes-research"
    | "fine-tune-pipeline"
    | "football-fuzzy"
    | "inventory-ga"
    | "load-balancing"
    | "neuro-symbolic"
    | "translation"
    | "book-recommender"
    | "occupancy"
    | "career-ontology"
    | "gallery-service";
}

const { kind } = Astro.props;
const labels = {
  autochess: {
    title: "Illustrative AutoChess machine schematic",
    description:
      "A schematic view of the chessboard and an XY electromagnet mechanism beneath its surface. It is an illustration, not a project photograph or a scale drawing.",
  },
  sentiview: {
    title: "SentiView email analysis workflow illustration",
    description:
      "Email ingestion and analysis flow from Gmail through a FastAPI service to AI processing and an analytics view.",
  },
  "blog-service": {
    title: "Chapters Blog Backend service illustration",
    description:
      "A backend service diagram showing API clients, the FastAPI service, authentication and MongoDB.",
  },
  "rag-platform": {
    title: "Adaptive multi-agent retrieval workflow illustration",
    description:
      "A question flows through query understanding, retrieval, context optimization and verification before grounded response synthesis, with pgvector and Redis shown as supporting systems.",
  },
  "ballerina-ft": {
    title: "Ballerina code model adaptation illustration",
    description:
      "A low-resource Ballerina corpus is prepared and used for LoRA adaptation of a small language model, followed by code completion evaluation.",
  },
  "choreo-pipeline": {
    title: "Choreo documentation AI pipeline illustration",
    description:
      "Documentation feeds two connected paths: question-answer dataset generation and fine-tuning, alongside a retrieval-augmented assistant.",
  },
  clickbait: {
    title: "Clickbait detection model comparison illustration",
    description:
      "Headline text branches into a supervised CNN path and an exploratory transformer-embedding path.",
  },
  compfigurator: {
    title: "PC component expert system illustration",
    description:
      "Workload and budget pass through compatibility rules to produce a PC build with component explanations.",
  },
  ddos: {
    title: "Network flow classification pipeline illustration",
    description:
      "Network flow records pass through modular feature transformations before comparison across Logistic Regression, autoencoder and DBSCAN approaches.",
  },
  "diabetes-research": {
    title: "Diabetes risk research pipeline illustration",
    description:
      "NHANES laboratory and lifestyle features enter a carefully evaluated LightGBM pipeline with cross-validation, feature comparison and ablation.",
  },
  "fine-tune-pipeline": {
    title: "Repeatable model fine-tuning workflow illustration",
    description:
      "A TOML configuration drives fine-tuning, inference and evaluation, with experiment tracking and local or CI execution paths.",
  },
  "football-fuzzy": {
    title: "Football detection confidence refinement illustration",
    description:
      "YOLOv8 detections are refined using fuzzy signals for position, shape, nearby players and original confidence.",
  },
  "inventory-ga": {
    title: "Genetic algorithm bin packing illustration",
    description:
      "Rectangular items are assigned to storage bins through an evolving search for value and space utilization.",
  },
  "load-balancing": {
    title: "Decentralized load balancing simulation illustration",
    description:
      "User and server agents negotiate peer-to-peer connections; no central load-balancing node is shown.",
  },
  "neuro-symbolic": {
    title: "Neuro-symbolic PC configuration illustration",
    description:
      "Natural language is interpreted by a local small language model, converted to structured intent and checked against Prolog compatibility rules.",
  },
  translation: {
    title: "English to Sinhala translation pipeline illustration",
    description:
      "English text passes through spelling correction, simplification and MBART translation to produce Sinhala text.",
  },
  "book-recommender": {
    title: "Hybrid book recommendation paths illustration",
    description:
      "Content, collaborative and PageRank recommendations contribute according to whether a reader is new or has interaction history.",
  },
  occupancy: {
    title: "Room occupancy time-series model pipeline illustration",
    description:
      "Environmental sensor readings are split in time order, transformed and evaluated with tree-based models and SHAP interpretation.",
  },
  "career-ontology": {
    title: "AI career domain ontology graph illustration",
    description:
      "A knowledge graph connects AI subfields, career roles, skills and learning resources for SPARQL exploration.",
  },
  "gallery-service": {
    title: "Event image gallery and QR sharing illustration",
    description:
      "An image upload creates a QR link that opens the image in the event gallery for browsing and sharing.",
  },
} as const;

const projectFlow = {
  "rag-platform": [
    ["QUERY", "Intent and type"],
    ["RETRIEVE", "pgvector search"],
    ["VERIFY", "Context checked"],
    ["RESPOND", "Grounded answer"],
  ],
  "ballerina-ft": [
    ["BALLERINA DATA", "Low-resource corpus"],
    ["PREPARE", "Collect and clean"],
    ["LoRA ADAPTATION", "Small language model"],
    ["COMPLETION", "Quality evaluation"],
  ],
  "choreo-pipeline": [
    ["CHOREO DOCS", "Markdown source"],
    ["QA DATA", "Generated pairs"],
    ["MODEL PATH", "LoRA fine-tuning"],
    ["RAG PATH", "Grounded assistant"],
  ],
  clickbait: [
    ["HEADLINES", "Tokenized text"],
    ["CNN MODEL", "Supervised path"],
    ["EMBEDDINGS", "Transformer space"],
    ["EXPLORATION", "Clustering in progress"],
  ],
  compfigurator: [
    ["WORKLOAD", "Budget and needs"],
    ["RULE ENGINE", "Compatibility facts"],
    ["BUILD", "Ranked alternatives"],
    ["EXPLANATION", "Why each part fits"],
  ],
  ddos: [
    ["FLOW RECORDS", "Network features"],
    ["TRANSFORM", "Clean and encode"],
    ["MODEL STUDY", "Three approaches"],
    ["CLASSIFY", "Benign or attack"],
  ],
  "diabetes-research": [
    ["NHANES DATA", "Labs and lifestyle"],
    ["FEATURE STUDY", "Group and ablate"],
    ["LIGHTGBM", "Stratified CV"],
    ["EVALUATE", "Tracked in MLflow"],
  ],
  "fine-tune-pipeline": [
    ["TOML CONFIG", "One experiment spec"],
    ["FINE-TUNE", "LoRA and Unsloth"],
    ["INFER + EVALUATE", "Separate stages"],
    ["TRACK", "W&B and CI runs"],
  ],
  "football-fuzzy": [
    ["VIDEO FRAME", "Football footage"],
    ["YOLOv8", "Candidate detections"],
    ["FUZZY RULES", "Position and shape"],
    ["REFINED SCORE", "Confidence blend"],
  ],
  "inventory-ga": [
    ["ITEMS + BINS", "Dimensions and value"],
    ["POPULATION", "Candidate layouts"],
    ["EVOLVE", "Selection and mutation"],
    ["ASSIGNMENTS", "Value and space"],
  ],
  "load-balancing": [
    ["USER AGENTS", "Seek a server"],
    ["SERVER PEERS", "Share load locally"],
    ["NEGOTIATE", "No central router"],
    ["EMERGENCE", "Balance or cascade"],
  ],
  "neuro-symbolic": [
    ["USER REQUEST", "Natural language"],
    ["LOCAL SLM", "Extract requirements"],
    ["JANUS-SWI", "Structured handoff"],
    ["PROLOG", "Check constraints"],
  ],
  translation: [
    ["ENGLISH TEXT", "Original input"],
    ["CORRECTION", "Guarded spelling"],
    ["SIMPLIFY", "Reduce syntax load"],
    ["MBART → SINHALA", "Quantized translation"],
  ],
  "book-recommender": [
    ["READER", "History or cold start"],
    ["CONTENT", "TF-IDF similarity"],
    ["COLLABORATIVE", "Reader similarity"],
    ["HYBRID", "PageRank + routing"],
  ],
  occupancy: [
    ["SENSOR SERIES", "Room conditions"],
    ["TIME SPLITS", "No future leakage"],
    ["TREE MODELS", "RF · XGBoost · LGBM"],
    ["INTERPRET", "SHAP features"],
  ],
  "career-ontology": [
    ["RDF / OWL", "Typed concepts"],
    ["GRAPHDB", "Knowledge graph"],
    ["SPARQL", "Competency queries"],
    ["EXPLORE", "Streamlit + Ollama"],
  ],
  "gallery-service": [
    ["UPLOAD", "Event image"],
    ["QR LINK", "Generated per image"],
    ["GALLERY", "Browse or latest"],
    ["SHARE", "Open on any device"],
  ],
} as const;

const flow =
  kind in projectFlow ? projectFlow[kind as keyof typeof projectFlow] : null;
---

<svg
  class="project-hero-illustration"
  viewBox="0 0 840 460"
  role="img"
  aria-labelledby="project-hero-illustration-title project-hero-illustration-description"
>
  <title id="project-hero-illustration-title">{labels[kind].title}</title>
  <desc id="project-hero-illustration-description"
    >{labels[kind].description}</desc
